            "source": [
                "def status(x):\n",
                "    if x < 0:\n",
                "        return \"Early\"\n",
                "    elif x == 0:\n",
                "        return \"On Time\"\n",
                "    else:\n",
                "        return \"Late\"\n",
                "\n",
                "df['Delivery_Status'] = df['Delay_Days'].apply(status)"
