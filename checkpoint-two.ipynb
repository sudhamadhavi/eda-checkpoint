            "source": [
                "# 1. Sales by delivery status\n",
                "# 1. Sales by delivery status (Pie Chart)\n",
                "sales_by_status = df.groupby('Delivery Status')['Sales'].sum()\n",
                "\n",
                "plt.figure(figsize=(8,6))\n",
                "plt.pie(\n",
                "    sales_by_status,\n",
                "    labels=sales_by_status.index,\n",
                "    autopct='%1.1f%%',\n",
                "    startangle=90\n",
                ")\n",
